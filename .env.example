# Local dev defaults. On Railway NOTHING here is required:
# - JWT_SECRET unset -> generated once, persisted to DATA_DIR/jwt.secret
# - ADMIN_SEED_PASSWORD unset -> random password printed once at first boot
# - DATABASE_URL is injected by Postgres (template / IaC / plugin)
# Set values below only to pin them locally.
PORT=8080
DATA_DIR=./data
DATABASE_URL=postgres://user:pass@localhost:5432/sellingbot?sslmode=disable
# JWT_SECRET — optional (min 32 chars when set)
# JWT_SECRET=
WHATSAPP_ENABLED=true
# ADMIN_SEED_EMAIL — optional (default admin@autokart.local)
# ADMIN_SEED_PASSWORD — optional (generated + logged once when unset)
TIMEZONE=Asia/Kuala_Lumpur
